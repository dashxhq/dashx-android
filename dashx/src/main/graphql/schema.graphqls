type Account {
  id: UUID!

  environmentId: UUID!

  email: String

  phone: String

  fullName: String

  name: String

  firstName: String

  lastName: String

  avatar: String

  gender: AccountGender

  dateOfBirth: NaiveDate

  timeZone: String

  uid: String

  anonymousUid: String

  createdAt: Timestamp!

  updatedAt: Timestamp!

  hasApiAccess: Boolean!

  hasGuiAccess: Boolean!

  custom: JSON

  status: AccountStatus!

  unconfirmedEmail: String

  confirmationDigest: String

  confirmationExpiresAt: Timestamp

  regularAccountId: UUID

  kind: AccountKind!

  tours: JSON!

  billingExternalUid: String

  isMfaEnabled: Boolean!

  workspaceId: UUID!

  purpose: AccountPurpose

  defaultGroupId: UUID

  externalUid: String

  externalMetadata: JSON

  identityToken: String

  workStatusIcon: String

  workStatusMessage: String

  computedWorkStatusPresence: AccountWorkStatusPresence!

  effectivePolicyAttachments: [PolicyAttachment!]!

  workStatusReadyForWork: Boolean!

  groupMemberships(filter: JSON, order: [JSON!], limit: Int): [GroupMembership!]!

  addresses(filter: JSON, order: [JSON!], limit: Int): [Address!]!

  taxRegistrations(filter: JSON, order: [JSON!], limit: Int): [TaxRegistration!]!
}

enum AccountGender {
  MALE

  FEMALE

  OTHER
}

enum AccountIdentityKind {
  USER

  VISITOR
}

enum AccountKind {
  MEMBER

  SERVICE

  USER

  VISITOR
}

enum AccountPurpose {
  API

  AGENT
}

enum AccountStatus {
  NOT_INVITED

  INVITED

  ONBOARDING

  ENABLED

  DISABLED
}

enum AccountTourStatus {
  PENDING

  COMPLETED

  SKIPPED
}

enum AccountTourType {
  WELCOME_OWNER_TOUR

  WELCOME_MEMBER_TOUR
}

enum AccountWorkStatusPresence {
  ONLINE

  AWAY

  BUSY

  INVISIBLE

  OFFLINE
}

